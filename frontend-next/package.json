{
  "name": "qmt-work-frontend-next",
  "private": true,
  "version": "0.3.5",
  "type": "module",
  "description": "qmt_work 量化平台 · 专业交易终端前端（全新工程）",
  "main": "electron/main.cjs",
  "scripts": {
    "dev": "vite",
    "build": "vite build",
    "preview": "vite preview",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "electron:dev": "electron .",
    "backend:build": "node ../scripts/backend-build.mjs",
    "pack": "npm run build && npm run backend:build && electron-builder --dir",
    "dist": "npm run build && npm run backend:build && electron-builder --win nsis",
    "dist:portable": "npm run build && npm run backend:build && electron-builder --win zip",
    "pkg:win": "npm run build && npm run backend:build && electron-builder --win"
  },
  "dependencies": {
    "echarts": "^5.5.1",
    "electron-updater": "^6.3.9",
    "klinecharts": "^10.0.3",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "zustand": "^5.0.15"
  },
  "devDependencies": {
    "@tanstack/react-virtual": "^3.10.8",
    "@testing-library/dom": "^10.4.0",
    "@testing-library/jest-dom": "^6.6.3",
    "@testing-library/react": "^16.1.0",
    "@types/node": "^22.20.2",
    "@types/react": "^18.3.12",
    "@types/react-dom": "^18.3.1",
    "@vitejs/plugin-react": "^4.3.4",
    "electron": "^31.0.0",
    "electron-builder": "^24.13.3",
    "jsdom": "^25.0.1",
    "typescript": "^5.7.2",
    "vite": "^5.4.11",
    "vitest": "^2.1.8"
  }
}
