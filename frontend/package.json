{
  "name": "qmt-work-frontend",
  "private": true,
  "version": "0.1.0-beta.1",
  "type": "module",
  "description": "qmt_work 量化平台 · 桌面壳",
  "author": "qmt_work",
  "main": "electron/main.cjs",
  "scripts": {
    "dev": "vite",
    "build": "vite build",
    "preview": "vite preview",
    "lint": "eslint . --max-warnings=0",
    "test": "vitest run",
    "electron:dev": "electron .",
    "backend:build": "node ../scripts/backend-build.mjs",
    "pack": "npm run build && npm run backend:build && electron-builder --dir",
    "dist": "npm run build && npm run backend:build && electron-builder --win nsis",
    "dist:portable": "npm run build && npm run backend:build && electron-builder --win zip",
    "pkg:win": "npm run build && npm run backend:build && electron-builder --win"
  },
  "build": {
    "appId": "com.qmtwork.desktop",
    "productName": "qmt_work",
    "copyright": "Copyright © 2026 qmt_work",
    "directories": {
      "output": "release",
      "buildResources": "build"
    },
    "extraResources": [
      {
        "from": "../backend/dist/qmt_work",
        "to": "backend/qmt_work"
      }
    ],
    "win": {
      "target": [
        {
          "target": "nsis",
          "arch": "x64"
        },
        {
          "target": "zip",
          "arch": "x64"
        }
      ],
      "artifactName": "${productName}-${version}-${os}-${arch}.${ext}"
    },
    "nsis": {
      "oneClick": false,
      "perMachine": false,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true
    }
  },
  "dependencies": {
    "echarts": "^5.5.1",
    "electron-updater": "^6.3.9",
    "react": "^18.3.1",
    "react-dom": "^18.3.1"
  },
  "devDependencies": {
    "@eslint/js": "^9.17.0",
    "@vitejs/plugin-react": "^4.3.4",
    "electron": "^31.0.0",
    "electron-builder": "^24.13.3",
    "eslint": "^9.17.0",
    "eslint-plugin-react-hooks": "^5.1.0",
    "globals": "^15.14.0",
    "puppeteer-core": "^20.9.0",
    "vite": "^5.4.11",
    "vitest": "^2.1.8"
  }
}
