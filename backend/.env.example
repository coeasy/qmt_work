# qmt_work 后端环境变量配置示例
# 复制为 .env 后按需修改；优先级：环境变量(QMT_*) > exe 同目录 qmt_work_config.json > .env > 默认值
# 真实券商模式：所有行情/交易/账户均走券商 SDK（XTQuant 等），无 mock；未连接券商时端点返回 503 引导。

# ---- 服务监听 ----
QMT_HOST=0.0.0.0
QMT_PORT=21117            # 默认 21117；被占用时自动 +1 平滑改口（最多 10 次，QMT_PORT_SCAN 调整范围）

# ---- 网关鉴权（生产环境务必修改，勿用默认值 qmt-dev-key）----
QMT_API_KEY=qmt-dev-key

# ---- 可选引导连接（不填则需在「券商连接」页添加）----
QMT_BROKER_ID=            # 券商档案 id，如 guojin（国金）
QMT_CLIENT_PATH=          # 券商客户端 userdata_mini 目录，如 C:/qmt/userdata_mini
QMT_ACCOUNT_ID=           # 资金账号
QMT_ACCOUNT_TYPE=STOCK    # STOCK / CREDIT / OPTION / FUTURES
QMT_SESSION_ID=0          # 迅投会话 id（整数）

# ---- 交易二次确认（大额下单需确认）----
QMT_SIGNAL_CONFIRM_THRESHOLD=100000
QMT_TOTP_SECRET=          # 非空时启用 TOTP 二次确认（RFC 6238）
QMT_TOTP_DIGITS=6

# ---- 外部信号 webhook 入站签名密钥（非空时校验 X-Signature 头）----
QMT_WEBHOOK_SECRET=

# ---- 风控默认值（运行期可在「设置 → 风控」调整，持久化到 risk_config 表）----
QMT_RISK_MAX_AMOUNT=100000        # 单笔最大金额
QMT_RISK_MIN_QTY=100              # 最小下单量
QMT_RISK_MAX_POSITION_RATIO=0.3   # 单标的最大持仓比例
QMT_RISK_MAX_SINGLE_POSITION_RATIO=0.2
QMT_RISK_MAX_ORDERS_PER_MIN=30    # 每分钟最大下单次数
# 日级风控（0 = 不启用，跨自然日自动重置）
QMT_RISK_DAILY_AMOUNT_LIMIT=0     # 日累计下单金额上限
QMT_RISK_DAILY_LOSS_LIMIT=0       # 日亏损熔断阈值
QMT_RISK_PER_CODE_DAILY_ORDERS=0  # 单标的日下单次数上限
# 预交易风控扩展（0/空 = 关闭）
QMT_RISK_PRICE_DEVIATION_PCT=0    # 下单价相对最新价允许偏离上限（0.05=±5%）
QMT_RISK_SYMBOL_ALLOW=            # 标的白名单（逗号分隔；空=全部允许）
QMT_RISK_SYMBOL_DENY=             # 标的黑名单（逗号分隔；命中即拒）

# ---- 订单超时守护（pending 超时自动撤单）----
QMT_ORDER_WATCHDOG_ENABLED=true
QMT_ORDER_WATCHDOG_TIMEOUT=60
QMT_ORDER_WATCHDOG_INTERVAL=5

# ---- 通知去重静默期（秒；0=关闭）----
QMT_NOTIFY_DEDUP_SECONDS=0

# ---- CORS（逗号分隔来源；空=不启用跨域，仅同源访问）----
QMT_CORS_ORIGINS=

# ---- 限流 ----
QMT_RATE_LIMIT_WINDOW=60
QMT_RATE_LIMIT_MAX=120

# ---- 行情共享总线（memory 或 redis）----
QMT_QUOTE_BUS_BACKEND=memory
QMT_QUOTE_BUS_REDIS_URL=redis://127.0.0.1:6379/0

# ---- 委托对账核销巡检间隔（秒）----
QMT_RECONCILE_INTERVAL=300

# ---- 历史 K 线本地缓存 TTL（秒）：日线 6h / 分钟线 60s ----
QMT_KLINE_CACHE_TTL_DAILY=21600
QMT_KLINE_CACHE_TTL_INTRADAY=60

# ---- 出站 webhook（HMAC-SHA256 签名 + 指数退避重试）----
QMT_WEBHOOK_OUT_RETRY_BACKOFF=2

# ---- P2 定时任务调度器轮询间隔（秒）----
QMT_SCHEDULER_INTERVAL=30

# ---- 数据库自动备份：启动/周期/关闭前各一次，保留最近 keep 份 ----
QMT_DB_BACKUP_ENABLED=true
QMT_DB_BACKUP_INTERVAL=3600
QMT_DB_BACKUP_KEEP=10

# ---- 存储与日志（默认跟随运行根目录：打包=exe 同目录 data/、logs/）----
# QMT_DB_PATH=./data/app.db
# QMT_LOG_DIR=./logs

# ---- 桌面壳/编排：把实际监听端口写入该文件（规避端口冲突探测）----
# QMT_PORT_FILE=/tmp/qmt_port.txt
